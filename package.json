{
  "name": "react-motion-gallery",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run dev --parallel",
    "build": "lerna run build",
    "lint": "lerna run lint",
    "test": "lerna run test",
    "analyze:skeleton-text": "npm run --silent analyze:skeleton-text --workspace packages/react-motion-gallery --",
    "generate:skeleton-text-module": "npm run --silent generate:skeleton-text-module --workspace packages/react-motion-gallery --",
    "generate:skeleton-text-browser-module": "npm run --silent generate:skeleton-text-browser-module --workspace packages/react-motion-gallery --",
    "release:rmg": "node ./scripts/release-rmg.mjs"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "lerna": "^8.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
