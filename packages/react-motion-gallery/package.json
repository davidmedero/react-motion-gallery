{
  "name": "react-motion-gallery",
  "version": "2.0.4",
  "description": "React Motion Gallery - smooth, customizable media gallery components",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "React Motion Gallery",
  "homepage": "https://react-motion-gallery.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmedero/react-motion-gallery.git",
    "directory": "packages/react-motion-gallery"
  },
  "bugs": {
    "url": "https://github.com/davidmedero/react-motion-gallery/issues"
  },
  "funding": {
    "type": "url",
    "url": "https://react-motion-gallery.com/pricing"
  },
  "commercialLicense": {
    "requiredForRevenueUse": true,
    "url": "https://react-motion-gallery.com/license"
  },

  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },

    "./slider": {
      "types": "./dist/slider/index.d.ts",
      "import": "./dist/slider/index.mjs"
    },

    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "import": "./dist/grid/index.mjs"
    },

    "./masonry": {
      "types": "./dist/masonry/index.d.ts",
      "import": "./dist/masonry/index.mjs"
    },

    "./entries": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/entries/index.mjs"
    },

    "./fullscreen": {
      "types": "./dist/fullscreen/index.d.ts",
      "import": "./dist/fullscreen/index.mjs"
    }
  },

  "files": [
    "dist"
  ],

  "sideEffects": [
    "*.css",
    "**/*.css"
  ],

  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0"
  },

  "peerDependenciesMeta": {
    "plyr": {
      "optional": true
    },
    "plyr-react": {
      "optional": true
    }
  },

  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup"
  },

  "devDependencies": {
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0"
  }
}