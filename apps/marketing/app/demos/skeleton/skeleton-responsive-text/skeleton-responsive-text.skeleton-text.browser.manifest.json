{
  "url": "http://127.0.0.1:3000/demos?demo=skeleton-responsive-text&skeletonMeasure=content",
  "outputFile": "./skeleton-responsive-text.skeleton-text.generated.ts",
  "moduleExportName": "skeletonResponsiveTextSkeletonText",
  "viewportMin": 320,
  "viewportMax": 1340,
  "viewportHeight": 1800,
  "viewportWorkers": 8,
