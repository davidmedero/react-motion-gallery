    },
    {
      "exportName": "responsiveTextItem03Title",
      "selector": "[data-skeleton-text-id='responsiveTextItem03Title']"
    },
    {
      "exportName": "responsiveTextItem03Body",
      "selector": "[data-skeleton-text-id='responsiveTextItem03Body']"
