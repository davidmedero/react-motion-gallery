{
  "url": "http://127.0.0.1:3000/demos?demo=masonry-lazy-load&skeletonMeasure=content",
  "outputFile": "./masonry-lazy-load.skeleton-text.generated.ts",
  "moduleExportName": "masonryLazyLoadSkeletonText",
  "viewportMin": 320,
  "viewportMax": 1330,
  "viewportHeight": 1800,
  "viewportWorkers": 8,
  "settleMs": 120,
  "stableGeometryFrames": 4,
  "readyExpression": "(() => { const body = document.querySelector(\"[data-skeleton-text-id='masonryLazyItem01Body']\"); const item = body?.closest(\"[data-rmg-idx]\"); const root = item?.parentElement; const columns = Number(getComputedStyle(root).getPropertyValue(\"--rmg-cols\")); const expected = window.innerWidth >= 1140 ? 3 : window.innerWidth >= 720 ? 2 : 1; return columns === expected; })()",
  "lineMeasurementMethod": "domRange",
  "includeTextMetrics": true,
  "breakpointStrategy": "lineChanges",
  "barWidthUnit": "px",
  "targets": [
