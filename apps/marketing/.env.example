NEXT_PUBLIC_SITE_URL=https://react-motion-gallery.com

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Magic-link email delivery. In local development, missing Resend env vars log
# the sign-in link to the server console and show a local-only link on /account.
RESEND_API_KEY=re_your_resend_api_key
AUTH_EMAIL_FROM="React Motion Gallery <account@mail.react-motion-gallery.com>"

# Stripe
# Prefer a restricted Stripe API key scoped to this app's API calls.
STRIPE_API_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_AUTOMATIC_TAX=false

# Stripe Price IDs
STRIPE_PRICE_SINGLE_COMMERCIAL_MONTHLY=price_single_monthly
STRIPE_PRICE_SINGLE_COMMERCIAL_YEARLY=price_single_yearly
STRIPE_PRICE_SINGLE_COMMERCIAL_LIFETIME=price_single_lifetime
STRIPE_PRICE_UNLIMITED_COMMERCIAL_MONTHLY=price_unlimited_monthly
STRIPE_PRICE_UNLIMITED_COMMERCIAL_YEARLY=price_unlimited_yearly
STRIPE_PRICE_UNLIMITED_COMMERCIAL_LIFETIME=price_unlimited_lifetime
