NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_generated_auth_secret

# Magic-link email delivery. In local development, missing Resend env vars log
# the sign-in link to the server console and show a local-only link on /account.
RESEND_API_KEY=replace_with_resend_api_key
AUTH_EMAIL_FROM="React Motion Gallery <noreply@example.com>"

# Stripe
# Prefer a restricted API key scoped to this app's API calls.
STRIPE_API_KEY=replace_with_stripe_restricted_api_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_AUTOMATIC_TAX=false

# Stripe Price IDs
STRIPE_PRICE_SINGLE_COMMERCIAL_MONTHLY=replace_with_stripe_price_id
STRIPE_PRICE_SINGLE_COMMERCIAL_YEARLY=replace_with_stripe_price_id
STRIPE_PRICE_SINGLE_COMMERCIAL_LIFETIME=replace_with_stripe_price_id
STRIPE_PRICE_UNLIMITED_COMMERCIAL_MONTHLY=replace_with_stripe_price_id
STRIPE_PRICE_UNLIMITED_COMMERCIAL_YEARLY=replace_with_stripe_price_id
STRIPE_PRICE_UNLIMITED_COMMERCIAL_LIFETIME=replace_with_stripe_price_id
